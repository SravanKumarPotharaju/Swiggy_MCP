# App Config
APP_NAME=SmartFlow
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api/v1
SECRET_KEY=generate-a-32-character-random-secret-key
ENCRYPTION_KEY=generate-a-32-byte-base64-or-hex-key

# Database & Cache
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=smartflow_db
REDIS_URL=redis://localhost:6379/0

# Swiggy MCP Configuration (Source of Truth: https://mcp.swiggy.com/builders/docs/)
SWIGGY_MCP_URL=https://mcp.swiggy.com/food
SWIGGY_AUTH_URL=https://mcp.swiggy.com/oauth/authorize
SWIGGY_TOKEN_URL=https://mcp.swiggy.com/oauth/token
SWIGGY_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
SWIGGY_CLIENT_ID=your_swiggy_client_id_if_provided
SWIGGY_CLIENT_SECRET=your_swiggy_client_secret_if_required

# CORS: origins allowed to make credentialed cross-origin requests (comma-separated, no "*").
# The bundled UI is served same-origin from "/", so this only matters for a separate front-end.
# Unset = the three local dev origins below. RENDER_EXTERNAL_URL is added automatically.
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000

# Public URL of the deployed service. Render sets this itself on deploy, so leave it commented
# out locally; when present it is added to the CORS allow-list above.
# RENDER_EXTERNAL_URL=https://your-service.onrender.com

# Proactive Concierge Defaults
ARRIVAL_ALERT_THRESHOLD_MINUTES=2
